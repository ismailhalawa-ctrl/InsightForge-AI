# ---- General ----
ENVIRONMENT=development
DEBUG=true

# ---- Backend (FastAPI) ----
API_V1_STR=/api/v1
SECRET_KEY=changeme
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ---- Database (PostgreSQL) ----
POSTGRES_USER=insightforge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=insightforge
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://insightforge:changeme@db:5432/insightforge
# Dedicated database for the PostgreSQL integration test suite (backend/
# tests/integration/**/*_postgres.py) -- those tests delete real rows as
# part of their cleanup, so this must always be a different database than
# DATABASE_URL above, never the dev/production one. Leave blank to default
# to DATABASE_URL with "_test" appended to the database name (created
# automatically by docker/postgres-init/ on a fresh volume). See
# docs/AUTH_AND_DATA_PERSISTENCE.md.
# TEST_DATABASE_URL=postgresql://insightforge:changeme@db:5432/insightforge_test

# ---- YouTube Data API ----
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_CACHE_TTL_MINUTES=60
YOUTUBE_COMMENT_CACHE_TTL_MINUTES=15
# Maximum comments the sentiment endpoint will collect (paginated) per analysis run
YOUTUBE_SENTIMENT_COMMENT_LIMIT=100

# ---- Text Processing ----
TEXT_REMOVE_EMOJIS=true
TEXT_LOWERCASE=true
TEXT_LANGUAGE_MIN_CONFIDENCE=0.7
SUPPORTED_LANGUAGES=["ar","en","es","fr","de","pt","it"]

# ---- Sentiment Analysis ----
# Revisions are pinned to the exact commit each model resolved to on the
# HuggingFace Hub as of 2026-08-06 -- leave blank only if you deliberately
# want to track a model's default branch instead of a fixed commit.
SENTIMENT_ARABIC_MODEL=Ammar-alhaj-ali/arabic-MARBERT-sentiment
SENTIMENT_ARABIC_MODEL_REVISION=db063587f876d5abcf6cdeed70648fc76a30349f
SENTIMENT_ENGLISH_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_ENGLISH_MODEL_REVISION=3216a57f2a0d9c45a2e6c20157c20c49fb4bf9c7
SENTIMENT_MIXED_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
SENTIMENT_MIXED_MODEL_REVISION=f2f1202b1bdeb07342385c3f807f9c07cd8f5cf8
SENTIMENT_BATCH_SIZE=16
SENTIMENT_MIN_CONFIDENCE=0.55
# "auto" resolves to cuda whenever torch reports CUDA available.
#
# Pin to "cpu" on any host where a local LLM shares the GPU. Measured on an
# RTX 3060 6GB with Qwen3-8B resident: CUDA fp16 makes the classifier stage
# 3.8x faster, but drops the LLM from 44.8 to 10.4 tok/s, which made a real
# HYBRID job take 8175s (with escalation batches failing) against 249s on CPU.
# The classifier speedup is real; it is simply not worth what it costs the
# escalation stage when both share one card.
#
# "auto"/"cuda" is the right setting when the LLM is remote or on a different
# GPU. See backend/scripts/sentiment_eval/stress_cuda_coexistence.py to
# re-derive this on your own hardware before changing it.
SENTIMENT_DEVICE=cpu
SENTIMENT_MAX_LENGTH=512

# ---- HYBRID/SMART sentiment escalation ----
# Local-first by design: no analysis mode may depend on a cloud key or quota.
# With the defaults below InsightForge runs fully offline; set a fallback
# provider only if you want optional cloud escalation.
# Accepted: lmstudio | openai_compatible | openai | gemini | none
SENTIMENT_LLM_PRIMARY_PROVIDER=lmstudio
SENTIMENT_LLM_FALLBACK_PROVIDER=none
# Any OpenAI-protocol endpoint: LM Studio, Ollama, vLLM, or a hosted service.
# Moving escalation to production inference is a change to these two values,
# not to any FAST/HYBRID/SMART logic.
SENTIMENT_LLM_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
SENTIMENT_LLM_LOCAL_MODEL=insightforge-qwen
# Tuned for a single local GPU. Concurrency above 1 does not increase
# throughput there -- llama.cpp serializes, so parallel requests only push
# each other past the timeout. Raise it for a hosted endpoint.
SENTIMENT_LLM_BATCH_SIZE=20
SENTIMENT_LLM_MAX_CONCURRENCY=1
SENTIMENT_LLM_TIMEOUT_SECONDS=120
# Absolute per-job ceilings in ITEMS, never a percentage of the corpus: LLM
# escalation is far slower per comment than the classifiers, so a percentage
# that is affordable at 1k comments is hours of work at 200k. These keep
# HYBRID/SMART a roughly constant addition to runtime at any dataset size.
SENTIMENT_LLM_HYBRID_MAX_ITEMS=250
SENTIMENT_LLM_SMART_MAX_ITEMS=700
SENTIMENT_LLM_HYBRID_TIME_BUDGET_SECONDS=300
SENTIMENT_LLM_SMART_TIME_BUDGET_SECONDS=900

MIXED_MIN_ARABIC_TOKENS=1
MIXED_MIN_ENGLISH_TOKENS=2
MIXED_MIN_SCRIPT_RATIO=0.10
MIXED_IGNORED_TECHNICAL_TERMS=["api","apis","python","fastapi","sql","github","git","html","css","json","http","https","url","sdk","cli","ui","ux","id","app","youtube","ai","cpu","gpu"]

# ---- Frontend (Sprint 24, Next.js) ----
# NEXT_PUBLIC_* values are baked into the client bundle at build time -- never
# put a secret in one. Social links default to safe placeholders in code
# (src/config/site.ts) when left blank; only GitHub has a known value.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/ismaeelhalawa-ctrl
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Purely cosmetic display string for the landing Pricing section (e.g.
# "$19/mo") -- the real amount always comes from Stripe Checkout itself at
# payment time (STRIPE_PRICE_ID_PRO below). Leave blank to show "shown at
# checkout" instead of inventing a number.
NEXT_PUBLIC_PRO_PRICE_DISPLAY=

# ---- LLM Provider (placeholder — no keys committed) ----
LLM_PROVIDER=
LLM_API_KEY=

# ---- Analysis Jobs (Sprint 11) ----
ANALYSIS_WORKER_POLL_INTERVAL_SECONDS=5
ANALYSIS_JOB_LEASE_SECONDS=120
ANALYSIS_JOB_MAX_ATTEMPTS=3
ANALYSIS_PROGRESS_UPDATE_INTERVAL=1
ANALYSIS_DEFAULT_COMMENT_LIMIT=100
ANALYSIS_MAX_COMMENT_LIMIT=5000
ANALYSIS_BATCH_SIZE=200
ANALYSIS_RETRY_BASE_DELAY_SECONDS=5
ANALYSIS_RETRY_MAX_DELAY_SECONDS=300

# Source quota waits. When a source publishes exactly when its quota resets
# (GitHub's X-RateLimit-Reset / Retry-After), the job is rescheduled for that
# instant and the wait does NOT consume one of ANALYSIS_JOB_MAX_ATTEMPTS --
# waiting is not failing, and GitHub's hourly window is far longer than the
# retry ladder's maximum delay. Bounded per-wait and in total so a
# permanently throttled source can never park a job forever.
ANALYSIS_QUOTA_WAIT_MAX_SINGLE_SECONDS=3900
ANALYSIS_QUOTA_WAIT_MAX_TOTAL_SECONDS=21600
ANALYSIS_QUOTA_WAIT_MIN_SECONDS=15

# Local development only: runs the analysis worker on a background thread of
# the API process itself (started/stopped from FastAPI's lifespan), so you
# don't need a second `python -m app.workers.analysis_worker` terminal while
# developing. Unset (no line at all) already defaults to this behavior when
# ENVIRONMENT=development, and to false otherwise -- set explicitly here only
# to override that default. Always set to false in production and run
# `python -m app.workers.analysis_worker` as its own process/deployment.
ANALYSIS_EMBEDDED_WORKER_ENABLED=true

# ==================================================
# Insight AI Providers (Sprint 12)
# ==================================================
# Both GEMINI_API_KEY and OPENAI_API_KEY are SECRETS. Leave them blank in any
# committed file. Fill them in only in your local, gitignored backend/.env.
#
# - Local insight mode (topics, complaints, suggestions, etc. via deterministic
#   rules + local embeddings) works fully with NO provider key configured.
# - AI/hybrid mode is optional and requires at least one provider's API key AND
#   its model identifier to be set; INSIGHT_AI_ENABLED=false disables it
#   entirely regardless of whether keys are present.
# - You may configure Gemini only, OpenAI only, or both. When both are set,
#   INSIGHT_AI_PRIMARY_PROVIDER is tried first and INSIGHT_AI_FALLBACK_PROVIDER
#   is used only if the primary fails (missing key/model, timeout, rate limit,
#   invalid output, etc.) -- either provider may be primary or fallback.
# - Never commit real key values, and never use fake key-shaped placeholders
#   (e.g. "sk-...") here -- leave these two lines blank.

INSIGHT_AI_ENABLED=false

# Allowed values: gemini, openai
INSIGHT_AI_PRIMARY_PROVIDER=gemini

# Allowed values: gemini, openai, none
INSIGHT_AI_FALLBACK_PROVIDER=openai

# Secrets -- leave blank in any committed file.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model identifiers are deliberately left blank by default. A blank model
# means that provider is treated as unavailable (local mode is unaffected).
# Verify currently supported model identifiers in each vendor's own docs
# before filling these in -- this project does not hardcode a guessed default.
INSIGHT_AI_GEMINI_MODEL=
INSIGHT_AI_OPENAI_MODEL=

INSIGHT_AI_TIMEOUT_SECONDS=900
INSIGHT_AI_MAX_RETRIES=1
INSIGHT_AI_REPAIR_RETRIES=1
INSIGHT_AI_TEMPERATURE=0.2
INSIGHT_AI_MAX_OUTPUT_TOKENS=4000
INSIGHT_AI_MAX_INPUT_CHARACTERS=60000
# MUST match the context the local model is actually loaded with (LM Studio
# reports it as contextLength; start-insightforge.ps1 sets it). Overstating it
# produces truncated JSON instead of a rejected request. On a 6 GB GPU running
# Qwen3-8B Q4_K_M, 8192 is the largest window whose KV cache still fits in
# VRAM -- 16384 measured ~6x slower on identical work because the cache spills
# to host RAM.
INSIGHT_AI_CONTEXT_TOKENS=8192
INSIGHT_AI_MAX_CLUSTERS_PER_REQUEST=24
INSIGHT_AI_MAX_EVIDENCE_PER_CLUSTER=4
INSIGHT_AI_MAX_TOTAL_EVIDENCE=60
INSIGHT_AI_MAX_DISCOVERY_EVIDENCE=180
# Discovery batches are independent, so they can run concurrently. The
# effective value is clamped at runtime to what the context window can hold
# (concurrency x (prompt + output)) -- a local server divides its window
# between simultaneous requests, and exceeding it fails the request outright
# rather than merely slowing it down.
INSIGHT_AI_DISCOVERY_CONCURRENCY=3
# Comments per discovery batch. Larger batches mean fewer calls but force more
# comments into the same bounded finding list, which costs recall.
INSIGHT_AI_DISCOVERY_BATCH_ITEMS=30
INSIGHT_AI_STRICT_MODE=false
INSIGHT_AI_LOCAL_FALLBACK_ENABLED=true
INSIGHT_AI_PROMPT_VERSION=v5

# ==================================================
# Local Insight Extraction (Sprint 12)
# ==================================================
# No secrets below. Works fully offline once the embedding model is cached.

INSIGHT_LOCAL_ENABLED=true
INSIGHT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
INSIGHT_EMBEDDING_DEVICE=cpu
INSIGHT_EMBEDDING_BATCH_SIZE=64
INSIGHT_CLUSTER_MIN_SIZE=3
INSIGHT_CLUSTER_MAX_TOPICS=20
INSIGHT_CLUSTER_SIMILARITY_THRESHOLD=0.68
INSIGHT_KEYWORD_LIMIT=30
INSIGHT_BIGRAM_LIMIT=20
INSIGHT_TRIGRAM_LIMIT=10
INSIGHT_EVIDENCE_LIMIT_PER_ITEM=5
# Generate the full Content Intelligence lineage during the analysis job
# rather than on first page open.
#
# With this off, a completed analysis holds NO insight rows until a user
# opens a capability page, which then blocks on a complete multi-batch
# generation -- which is what made previously analysed videos appear to
# "lose" their intelligence: they had never been given any to keep.
#
# Generating at job time makes every later read cache-only, which is what
# lets History be a genuine read-only snapshot. Failure never fails the job.
# See docs/AI_RESULT_PERSISTENCE.md.
INSIGHT_GENERATE_ON_JOB_COMPLETION=true

# NOTE: schema_version and prompt_version are DEPLOYMENT configuration, not
# properties of an analysis. Bumping either permits regeneration; it never
# hides results already generated -- reads fall back to the newest surviving
# successful row for the analysis. See docs/AI_RESULT_PERSISTENCE.md.
INSIGHT_SCHEMA_VERSION=1

# ==================================================
# Authentication and Authorization (Sprint 13)
# ==================================================
# AUTH_ACCESS_TOKEN_SECRET and AUTH_REFRESH_TOKEN_PEPPER are SECRETS. Leave
# them blank in any committed file. Outside ENVIRONMENT=production, a blank
# value is auto-generated per process start (dev convenience -- but every
# session is invalidated on restart). In production a blank value is refused
# at startup. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_REFRESH_TOKEN_PEPPER=

AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_ALLOW_REGISTRATION=true

AUTH_RATE_LIMIT_ENABLED=true
# Only trust X-Forwarded-For for rate-limit keying behind a real reverse proxy.
AUTH_TRUST_PROXY_HEADERS=false
AUTH_LOGIN_RATE_LIMIT_REQUESTS=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT_REQUESTS=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
ANALYSIS_CREATE_RATE_LIMIT_REQUESTS=10
ANALYSIS_CREATE_RATE_LIMIT_WINDOW_SECONDS=60
INSIGHT_GENERATE_RATE_LIMIT_REQUESTS=20
INSIGHT_GENERATE_RATE_LIMIT_WINDOW_SECONDS=60

# Usage protection (not billing) -- must never exceed the global
# ANALYSIS_MAX_COMMENT_LIMIT above; validated at startup.
USAGE_MAX_ACTIVE_ANALYSIS_JOBS_PER_USER=3
USAGE_MAX_ANALYSIS_JOBS_PER_DAY=25
USAGE_MAX_COMMENT_LIMIT_PER_JOB=1000

# ==================================================
# Redis (Sprint 14)
# ==================================================
# Local: redis://localhost:6379/0 -- Docker: redis://redis:6379/0
# Never expose Redis publicly in production -- no host port mapping, and
# bind it to an internal/private network only.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3
REDIS_HEALTHCHECK_INTERVAL_SECONDS=30
REDIS_KEY_PREFIX=insightforge

# Allowed values: redis, memory
RATE_LIMIT_BACKEND=redis
# If Redis is the configured backend but becomes unreachable: fall back to
# the bounded in-memory limiter (true, the safe default) or, if false, either
# fail-open (let requests through) or fail-closed (503) per RATE_LIMIT_FAIL_OPEN.
RATE_LIMIT_ALLOW_IN_MEMORY_FALLBACK=true
RATE_LIMIT_FAIL_OPEN=false
# SECRET -- leave blank in any committed file. Auto-generated outside
# production; refused if blank in production. Never reuse another pepper here.
RATE_LIMIT_IDENTITY_PEPPER=

AUTH_RESEND_VERIFICATION_RATE_LIMIT_REQUESTS=3
AUTH_RESEND_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_FORGOT_PASSWORD_RATE_LIMIT_REQUESTS=3
AUTH_FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_RESET_PASSWORD_RATE_LIMIT_REQUESTS=5
AUTH_RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=3600
ADMIN_MUTATION_RATE_LIMIT_REQUESTS=20
ADMIN_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60

# ==================================================
# Email verification and password reset (Sprint 14)
# ==================================================
AUTH_EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=300
AUTH_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=20

# ==================================================
# Session fingerprinting (Sprint 14)
# ==================================================
# SECRET -- leave blank in any committed file. Auto-generated outside
# production; refused if blank in production. Never reuse another pepper here.
AUTH_SESSION_FINGERPRINT_PEPPER=
AUTH_SESSION_USER_AGENT_MAX_LENGTH=512

# ==================================================
# Security notifications (Sprint 14)
# ==================================================
AUTH_NOTIFY_ON_PASSWORD_CHANGE=true
AUTH_NOTIFY_ON_NEW_LOGIN=false
AUTH_NOTIFY_ON_REFRESH_REPLAY=true

# ==================================================
# Email delivery (Sprint 14)
# ==================================================
# Allowed values: smtp, console. 'console' writes email content (including
# tokens) to process logs -- refused outright in production.
# Local dev: run Mailpit (docker compose up -d mailpit) and use the SMTP
# defaults below unchanged. UI at http://localhost:8025.
EMAIL_BACKEND=smtp
EMAIL_FROM_ADDRESS=no-reply@insightforge.local
EMAIL_FROM_NAME=InsightForge AI
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
# SECRET -- leave blank in any committed file.
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=false
EMAIL_SMTP_TIMEOUT_SECONDS=10

EMAIL_OUTBOX_WORKER_POLL_INTERVAL_SECONDS=3
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_RETRY_BASE_DELAY_SECONDS=30
EMAIL_OUTBOX_RETRY_MAX_DELAY_SECONDS=900

# ==================================================
# Frontend links (Sprint 14)
# ==================================================
# Used to build verification/reset links server-side. Must be https:// and
# not localhost in production.
FRONTEND_PUBLIC_URL=http://localhost:3000
AUTH_EMAIL_VERIFICATION_PATH=/verify-email
AUTH_PASSWORD_RESET_PATH=/reset-password

# ==================================================
# Security-token pepper (Sprint 14.1)
# ==================================================
# Dedicated pepper for hashing email-verification/password-reset tokens.
# Independent from AUTH_REFRESH_TOKEN_PEPPER and every other secret below --
# never reuse one pepper for two purposes. SECRET -- leave blank in any
# committed file. Auto-generated outside production; refused if blank in
# production. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECURITY_TOKEN_PEPPER=

# ==================================================
# Multi-source domain (Sprint 15)
# ==================================================
# No secrets here -- connector-specific credentials (e.g. YOUTUBE_API_KEY
# above) remain the only per-source secret this project persists.
SOURCE_COLLECTION_BATCH_SIZE=100
SOURCE_RECORD_TEXT_MAX_LENGTH=20000
SOURCE_METADATA_MAX_BYTES=8192
SOURCE_CHECKPOINT_ENABLED=true
SOURCE_CONNECTOR_VERSION=1
SOURCE_DATASET_PAGE_SIZE=20

# ==================================================
# File import connector (Sprint 16)
# ==================================================
# No secrets here. FILE_IMPORT_STORAGE_PATH is a local directory (created if
# missing) outside the Python source tree -- never served as static content.
FILE_IMPORT_ENABLED=true
FILE_IMPORT_STORAGE_BACKEND=local
FILE_IMPORT_STORAGE_PATH=var/file_imports
FILE_IMPORT_MAX_FILE_SIZE_MB=25
FILE_IMPORT_MAX_ROWS=100000
FILE_IMPORT_MAX_COLUMNS=100
FILE_IMPORT_MAX_CELL_CHARACTERS=10000
FILE_IMPORT_MAX_JSON_DEPTH=5
FILE_IMPORT_PROFILE_ROWS=200
FILE_IMPORT_BATCH_SIZE=500
FILE_IMPORT_RETENTION_HOURS=24
FILE_IMPORT_ALLOWED_FORMATS=["csv","xlsx","json"]
FILE_IMPORT_CSV_DELIMITER_AUTO_DETECT=true
FILE_IMPORT_CSV_ALLOWED_DELIMITERS=[",",";","\t","|"]
FILE_IMPORT_CSV_ALLOWED_ENCODINGS=["utf-8","utf-8-sig"]
FILE_IMPORT_XLSX_MAX_SHEETS=20
FILE_IMPORT_XLSX_MAX_SHARED_STRINGS=200000
FILE_IMPORT_XLSX_MAX_UNCOMPRESSED_BYTES=314572800
FILE_IMPORT_XLSX_MAX_COMPRESSION_RATIO=100.0
FILE_IMPORT_INVALID_ROW_POLICY=skip
FILE_IMPORT_MAX_INVALID_ROWS=50000
FILE_IMPORT_MAX_PERSISTED_ROW_ERRORS=1000
FILE_IMPORT_FAIL_ON_ERROR_RATIO=0.5
FILE_IMPORT_MAX_ACTIVE_IMPORTS_PER_USER=5
FILE_IMPORT_MAX_STORED_BYTES_PER_USER=262144000
FILE_IMPORT_MAX_BYTES_PER_USER_PER_DAY=524288000
FILE_IMPORT_UPLOAD_RATE_LIMIT_REQUESTS=10
FILE_IMPORT_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600

# ==================================================
# GitHub repository connector (Sprint 18)
# ==================================================
# Disabled by default -- the connector reports available=false and every
# /api/v1/sources/github/* endpoint refuses with a clear error until enabled.
# Public repositories work with no token; set a user's personal access token
# via POST /api/v1/sources/github/connections for private repositories or
# higher rate limits. Only the encrypted token is ever persisted.
GITHUB_CONNECTOR_ENABLED=false
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28

# SECRET -- leave blank in any committed file. A server-level GitHub personal
# access token (classic or fine-grained), used as the DEFAULT credential for
# requests that carry no per-user one.
#
# Leave empty to keep today's behavior: requests go out unauthenticated and
# public repositories still work, just on GitHub's much smaller anonymous
# quota. Set it to lift that limit substantially.
#
# Precedence: a per-user connection credential (POST /api/v1/sources/github/
# connections) ALWAYS wins over this value.
#
# This token is NOT user-scoped: every request without a per-user credential
# is made as its account. On a multi-user instance, give it PUBLIC-repository
# access only and use per-user connections for private repositories, which
# stay scoped to the user who supplied them.
GITHUB_TOKEN=
GITHUB_REQUEST_TIMEOUT_SECONDS=15
# Short, bounded retries for transient failures only (connection errors,
# timeouts, 5xx). Every request the connector makes is a GET, so retrying is
# safe. Rate limits are never retried here -- they are waited out at the job
# level, see ANALYSIS_QUOTA_WAIT_* below.
GITHUB_MAX_RETRIES=2
GITHUB_RETRY_BASE_DELAY_SECONDS=0.5
# Pagination GEOMETRY, not a budget: sent as `per_page` on every request and
# never varied within a pagination sequence (a changing per_page makes
# `page=N` address a different window and silently skips records). 100 is
# GitHub's documented maximum for every endpoint used here.
GITHUB_COLLECTION_PAGE_SIZE=100
# Per-call work bound for the reviews phase, NOT a ceiling on how many pull
# requests are ever reviewed -- that phase re-walks the /pulls listing from a
# persisted cursor and has no cap.
GITHUB_REVIEW_PRS_PER_PAGE=10
# A secondary-rate-limit Retry-After at or below this is simply slept off
# inline; anything longer is escalated to a job-level quota wait so a worker
# is never parked on a long sleep.
GITHUB_INLINE_RETRY_MAX_WAIT_SECONDS=30
# Conditional requests (ETag) for repository metadata only. Saves
# transferring and re-parsing an unchanged repository's metadata; it does not
# save primary quota. Deliberately not applied to list pages, whose ETags
# change constantly and would risk resumable-pagination correctness.
GITHUB_CONDITIONAL_REQUESTS_ENABLED=true

# ---- Repository documents (Phase 3) ----
# Human-readable project documentation (README, docs/, CONTRIBUTING, ...)
# collected as ordinary source records and used as REFERENCE context -- never
# counted as user feedback, so documentation cannot move sentiment, complaints
# or topics. This is not source-code ingestion: see
# backend/app/connectors/github_documents.py for the inclusion policy.
#
# Cost: ONE recursive tree request per repository, then at most
# GITHUB_MAX_DOCUMENTS blob requests. Candidates are filtered from the tree
# BEFORE any content is fetched, so request count tracks how much
# documentation a repository has, never how large the repository is.
GITHUB_INCLUDE_DOCUMENTS=true
GITHUB_MAX_DOCUMENTS=40
# Per-file ceiling, checked against the tree's own size so an oversized file
# is skipped without ever being downloaded.
GITHUB_DOCUMENT_MAX_BYTES=262144
# Whole-run ceiling across all documents.
GITHUB_DOCUMENTS_TOTAL_MAX_BYTES=2097152

# There is deliberately NO per-job record ceiling. Retrieval is bounded by
# what the user explicitly asked for, by GitHub's own quota, by cancellation,
# and by the job lease. (The former GITHUB_MAX_RECORDS_PER_JOB=2000 silently
# truncated every real repository while still reporting the run complete, and
# conflated source retrieval with downstream AI evidence budgets.)

# SECRET -- leave blank in any committed file. Required whenever
# GITHUB_CONNECTOR_ENABLED=true in production; auto-generated outside
# production (every stored credential becomes undecryptable on restart when
# auto-generated -- fine for local dev only). Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=

# ==================================================
# Action Center (Sprint 19)
# ==================================================
# No secrets here. Lets users turn a structured signal (or a manual idea)
# into a trackable ActionPlan with ActionTasks -- purely internal
# record-keeping, never an external action (no Jira/GitHub issue/webhook).
ACTION_CENTER_ENABLED=true
ACTION_PLAN_MAX_PER_USER=200
ACTION_TASK_MAX_PER_PLAN=100
ACTION_EVENT_MAX_PAGE_SIZE=100
ACTION_REQUIRE_TASKS_COMPLETE_FOR_PLAN_COMPLETION=true
ACTION_DEFAULT_PAGE_SIZE=20
ACTION_MAX_PAGE_SIZE=100
ACTION_EVENT_VALUE_MAX_BYTES=4096
ACTION_WRITE_RATE_LIMIT_REQUESTS=30
ACTION_WRITE_RATE_LIMIT_WINDOW_SECONDS=60

# ==================================================
# Trend intelligence (Sprint 20)
# ==================================================
# No secrets here. Compares two completed AnalysisJobs from the same
# SourceDataset -- signal matching and trend classification are 100%
# deterministic, code-computed; AI enrichment below is optional narrative
# only and can never alter a match, count, trend, or outcome.
TREND_INTELLIGENCE_ENABLED=true
TREND_MATCH_THRESHOLD=0.45
TREND_MIN_RECORDS_PER_JOB=5
TREND_MIN_SIGNAL_COUNT=2
TREND_STABLE_CHANGE_TOLERANCE=15.0
TREND_RISING_THRESHOLD=25.0
TREND_FALLING_THRESHOLD=25.0
TREND_DEFAULT_WINDOW_DAYS=30
TREND_MAX_WINDOW_DAYS=365
TREND_MAX_SIGNALS_PER_COMPARISON=200
TREND_OUTCOME_MIN_POST_ACTION_RECORDS=3
TREND_ALGORITHM_VERSION=v1
TREND_DEFAULT_PAGE_SIZE=20
TREND_MAX_PAGE_SIZE=100
TREND_WRITE_RATE_LIMIT_REQUESTS=20
TREND_WRITE_RATE_LIMIT_WINDOW_SECONDS=60

# Optional AI narrative for a comparison -- reuses the same Gemini/OpenAI
# keys/models as Sprint 12/17 above; disabled entirely falls back to a
# deterministic local summary.
TREND_PROVIDER_ENRICHMENT_ENABLED=true
TREND_PROVIDER_TIMEOUT_SECONDS=30
TREND_PROVIDER_MAX_RETRIES=1
TREND_PROVIDER_MAX_EVIDENCE_EXCERPTS=5
TREND_PROVIDER_MAX_EXCERPT_CHARS=200

# ==================================================
# Ask Your Data and Reports (Sprint 21)
# ==================================================
# No secrets here. Grounded question-answering and structured reports over a
# user's own already-analyzed data. Retrieval is 100% deterministic and
# ownership-scoped; AI (below) only narrates already-retrieved, bounded
# context and can never invent a count, cause, user, release, or outcome.
# No raw question text or provider prompt/response is ever persisted.
ASK_DATA_ENABLED=true
ASK_DATA_MAX_QUESTION_LENGTH=1000
ASK_DATA_MAX_CONTEXT_ITEMS=50
ASK_DATA_MAX_EVIDENCE_EXCERPTS=20
ASK_DATA_MAX_EXCERPT_CHARS=200
ASK_DATA_CACHE_TTL_SECONDS=900
ASK_DATA_WRITE_RATE_LIMIT_REQUESTS=20
ASK_DATA_WRITE_RATE_LIMIT_WINDOW_SECONDS=60

# Optional AI narrative for both Ask Your Data and Reports -- reuses the
# same Gemini/OpenAI keys/models as Sprint 12/17/20 above; disabled (or on
# any provider failure) falls back to a deterministic local answer/report.
ASK_DATA_PROVIDER_ENABLED=true
ASK_DATA_PROVIDER_TIMEOUT_SECONDS=30
ASK_DATA_PROVIDER_MAX_RETRIES=1

REPORTS_ENABLED=true
REPORT_MAX_PER_USER=200
REPORT_MAX_SECTIONS=20
REPORT_ALGORITHM_VERSION=v1
REPORT_DEFAULT_PAGE_SIZE=20
REPORT_MAX_PAGE_SIZE=100
REPORT_WRITE_RATE_LIMIT_REQUESTS=10
REPORT_WRITE_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Reddit connector
# =============================================================================
# Reddit is analyzed exclusively through its OAuth JSON API. There is no HTML
# scraping path and there is no anonymous path: without credentials the
# connector reports itself unavailable rather than degrading to something
# unsupported.
#
# HOW TO GET CREDENTIALS
# ----------------------
#   1. Sign in to Reddit and open https://www.reddit.com/prefs/apps
#   2. "create another app..."
#   3. Choose the "script" type for a server-side deployment.
#      (An "installed app" also works and uses an EMPTY client secret.)
#   4. Redirect URI can be http://localhost:8000/ -- this product uses the
#      client-credentials grant and never redirects a user through Reddit.
#   5. REDDIT_CLIENT_ID is the short string under the app name.
#      REDDIT_CLIENT_SECRET is the field labelled "secret".
#
# Nothing here is a user credential: the client-credentials grant
# authenticates the APPLICATION, so no Reddit account is implicated in what
# is collected and no user secret is ever stored.
REDDIT_CONNECTOR_ENABLED=false
REDDIT_API_BASE_URL=https://oauth.reddit.com
REDDIT_OAUTH_TOKEN_URL=https://www.reddit.com/api/v1/access_token
REDDIT_CLIENT_ID=
# SECRET -- never commit a real value. Leave EMPTY for an "installed app";
# a "script" or "web app" requires it and Reddit answers 401 without one.
REDDIT_CLIENT_SECRET=
# Reddit REQUIRES a descriptive, unique User-Agent and rate-limits generic
# ones aggressively. Their documented format is
# "<platform>:<app id>:<version> (by /u/<your reddit username>)".
# Put YOUR OWN username here -- a shared default is exactly the kind of
# generic agent Reddit throttles.
REDDIT_USER_AGENT=insightforge/1.0 (by /u/insightforge)

REDDIT_REQUEST_TIMEOUT_SECONDS=20
REDDIT_MAX_RETRIES=2
REDDIT_RETRY_BASE_DELAY_SECONDS=0.75
# How long a rate-limit wait may be absorbed inline before the connector
# stops and hands the job runner a quota error to schedule properly. Short
# waits are cheaper to sit out than to re-queue; long ones are not.
REDDIT_INLINE_RETRY_MAX_WAIT_SECONDS=30

# Reddit's own documented maximum for `limit` on listing endpoints. This is
# pagination geometry, not a budget: it must not vary within one pagination
# sequence, because an `after` cursor addresses a different window when the
# page size changes.
REDDIT_LISTING_PAGE_SIZE=100

# Safety caps. Every one of these is re-applied on EVERY collection pass, so
# lowering one takes effect immediately -- including for analyses that were
# configured under a higher ceiling.
#
# Absolute ceiling on analyzable records (posts + comments + replies) for one
# analysis. The effective limit is the smaller of this and the account's
# USAGE_MAX_COMMENT_LIMIT_PER_JOB.
REDDIT_MAX_RECORDS_PER_ANALYSIS=5000
# Subreddit mode: the UI offers 10/25/50 posts; this is the hard ceiling.
REDDIT_MAX_POSTS_PER_SUBREDDIT=50
REDDIT_DEFAULT_POSTS_PER_SUBREDDIT=25
# Per-post comment ceiling in subreddit mode, so one enormous thread cannot
# consume the whole record budget and leave the other posts unrepresented.
REDDIT_MAX_COMMENTS_PER_POST=500

# Reddit collapses deep comment trees into "load more" stubs. This is a
# REQUEST budget for expanding them, not a depth limit -- a popular thread's
# stubs regenerate as each batch is expanded, so following them to
# exhaustion is unbounded work.
REDDIT_MAX_MORE_CHILDREN_REQUESTS=40
# Reddit's documented cap for ids per `morechildren` call.
REDDIT_MORE_CHILDREN_BATCH_SIZE=100
# Stop expanding replies below this depth. The deepest nodes of a Reddit
# tree are almost always two-word exchanges -- past this point each request
# buys structure, not signal.
REDDIT_MAX_COMMENT_DEPTH=10

# Slow down (rather than hammer) once remaining quota falls below this
# fraction of the window's limit. An UNKNOWN quota is never treated as an
# exhausted one, so a deployment whose proxy strips the rate-limit headers
# keeps collecting normally.
REDDIT_RATE_LIMIT_SLOWDOWN_THRESHOLD=0.15
